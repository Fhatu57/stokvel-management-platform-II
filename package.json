{
  "name": "stokvel-management-platform",
  "version": "2.0.0",
  "private": true,
  "description": "A portfolio-ready platform for managing South African savings groups.",
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/server.js",
    "dev": "npm --workspace backend run dev",
    "build:config": "node scripts/generate-public-config.mjs",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --workspace backend test -- --runInBand",
    "test:frontend": "npm --workspace frontend test -- --runInBand",
    "check": "node --check backend/server.js"
  }
}
